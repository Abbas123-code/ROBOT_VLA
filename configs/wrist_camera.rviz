Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Name: root
  Value: true
  Global Options:
    Background Color: 35; 38; 45
    Fixed Frame: world
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Reference Frame: world
    - Class: rviz_default_plugins/TF
      Name: Wrist camera frames
      Enabled: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.2
    - Class: rviz_default_plugins/Image
      Name: Wrist RGB
      Enabled: true
      Value: true
      Topic:
        Value: /wrist_camera/color/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 2
      Transport Hint: raw
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Wrist YOLO boxes
      Enabled: true
      Value: true
      Topic:
        Value: /wrist_camera/detections/image
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 2
      Transport Hint: raw
      Normalize Range: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.8
      Pitch: 0.6
      Yaw: 0.8
      Focal Point:
        X: 0.4
        Y: 0
        Z: 0.4
Window Geometry:
  Wrist RGB:
    collapsed: false
  Wrist YOLO boxes:
    collapsed: false
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1400
  Height: 900
  X: 50
  Y: 50