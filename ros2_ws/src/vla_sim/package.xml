<?xml version="1.0"?>
<package format="3">
  <name>vla_sim</name>
  <version>0.1.0</version>
  <description>Simulation-only Panda joint commands and state monitoring.</description>
  <maintainer email="maintainer@example.com">ROBOT_VLA maintainers</maintainer>
